#!/bin/sh

set -eu

if [ "$#" -ne 0 ]; then
  echo "Usage: suyabai" >&2
  exit 2
fi

if [ -x /opt/homebrew/bin/yabai ]; then
  yabai_bin=/opt/homebrew/bin/yabai
elif [ -x /usr/local/bin/yabai ]; then
  yabai_bin=/usr/local/bin/yabai
else
  echo "suyabai: Homebrew yabai is not installed" >&2
  exit 1
fi

username="$(/usr/bin/id -un)"
sha256="$(/usr/bin/shasum -a 256 "$yabai_bin" | /usr/bin/awk '{print $1}')"
if [ "${#sha256}" -ne 64 ]; then
  echo "suyabai: failed to calculate the yabai SHA-256 digest" >&2
  exit 1
fi
case "$sha256" in
  *[!0-9a-f]*)
    echo "suyabai: failed to calculate the yabai SHA-256 digest" >&2
    exit 1
    ;;
esac

umask 077
sudoers_tmp="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/yabai-sudoers.XXXXXX")"
trap '/bin/rm -f "$sudoers_tmp"' EXIT
trap 'exit 1' HUP INT TERM

printf '%s ALL=(root) NOPASSWD: sha256:%s %s --load-sa\n' \
  "$username" "$sha256" "$yabai_bin" > "$sudoers_tmp"
/usr/sbin/visudo -cf "$sudoers_tmp"
/usr/bin/sudo /usr/bin/install -o root -g wheel -m 0440 \
  "$sudoers_tmp" /private/etc/sudoers.d/yabai
/usr/bin/sudo -n "$yabai_bin" --load-sa

echo "Updated /private/etc/sudoers.d/yabai and loaded the scripting addition."
