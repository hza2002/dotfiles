# https://ghostty.org/docs/config/reference

font-family = "JetBrains Maple Mono"
font-size = 14
# improves rendering on non-Apple external displays
font-thicken = true

theme = "Gruvbox Dark"
# Gruvbox expects bold text to use bright color variants (classic terminal behavior)
bold-is-bright = true

# hide the titlebar but keep the native macOS window frame (preserves rounded corners for borders/yabai)
macos-titlebar-style = hidden
# left/right breathing room
window-padding-x = 6
window-padding-y = 0
# distribute the cell-remainder space evenly between top and bottom instead of piling it at the bottom
window-padding-balance = true
# no shadow when decoration is off
macos-window-shadow = false
# don't show the size popup when resizing the window
resize-overlay = never
# tmux owns session state; Ghostty should not restore windows on relaunch
window-save-state = never

# bar cursor avoids confusion with vim normal mode (block)
cursor-style = bar

# treats Option as Alt, required for nvim and zsh Alt-key bindings
macos-option-as-alt = true

# quit the app when the last window closes, don't linger in the Dock
quit-after-last-window-closed = true
# updates are managed by brew; disable the built-in update checker
auto-update = off

# open Ghostty → attach the Main tmux session, create it if absent.
# new-session -A is the canonical attach-or-create form and lets
# tmux-continuum's auto-restore run on a fresh server.
command = /opt/homebrew/bin/zsh --login -c "tmux new-session -A -s Main"
# ssh-terminfo pushes terminfo to remote hosts, fixing garbled output over SSH
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# hide the mouse pointer while typing
mouse-hide-while-typing = true
# send a macOS notification when a command finishes while Ghostty is not focused
notify-on-command-finish = unfocused
# notification only, no terminal bell
notify-on-command-finish-action = no-bell,notify
# only notify if the command ran longer than 10 seconds
notify-on-command-finish-after = 10s
# block terminal applications from reading or replacing the system clipboard via OSC 52
clipboard-read = deny
clipboard-write = deny
# strip trailing whitespace on copy for cleaner pastes
clipboard-trim-trailing-spaces = true
# 100 MB scrollback; default is 10 MB
scrollback-limit = 100000000
# Slow discrete mouse-wheel scrolling without changing trackpad behavior.
mouse-scroll-multiplier = discrete:1
# 640 MB for Kitty graphics protocol, used by yazi image preview
image-storage-limit = 640000000

# Translate high-frequency macOS shortcuts to tmux's C-f prefix bindings.
# tmux remains fully usable from other terminals through the same prefix keys.
# Encode Shift+Enter like Option+Enter so it survives older remote tmux versions.
keybind = shift+enter=text:\x1b\r
keybind = cmd+n=text:\x06C
keybind = cmd+t=text:\x06c
keybind = cmd+o=text:\x06O
keybind = cmd+/=text:\x06F
keybind = cmd+a=text:\x06A
keybind = cmd+shift+a=text:\x06\x1bA
keybind = cmd+shift+o=text:\x06s
keybind = cmd+w=text:\x06x
keybind = cmd+tab=text:\x06`
keybind = alt+tab=text:\x06\x09
keybind = cmd+h=text:\x06p
keybind = cmd+l=text:\x06n
keybind = cmd+space=text:\x06\x20
keybind = cmd+enter=text:\x06z
keybind = cmd+y=text:\x06[

# Comma reloads configuration; Shift targets the outer Ghostty layer.
keybind = cmd+,=text:\x06r

# R renames the current tmux container; Shift targets the session.
keybind = cmd+r=text:\x06,
keybind = cmd+shift+r=text:\x06R

# Ghostty reports number-row keys by both logical and physical names,
# depending on the active keyboard layout.
keybind = cmd+1=text:\x061
keybind = cmd+digit_1=text:\x061
keybind = cmd+2=text:\x062
keybind = cmd+digit_2=text:\x062
keybind = cmd+3=text:\x063
keybind = cmd+digit_3=text:\x063
keybind = cmd+4=text:\x064
keybind = cmd+digit_4=text:\x064
keybind = cmd+5=text:\x065
keybind = cmd+digit_5=text:\x065
keybind = cmd+6=text:\x066
keybind = cmd+digit_6=text:\x066
keybind = cmd+7=text:\x067
keybind = cmd+digit_7=text:\x067
keybind = cmd+8=text:\x068
keybind = cmd+digit_8=text:\x068
keybind = cmd+9=text:\x069
keybind = cmd+digit_9=text:\x069

# Shift+W closes the containing tmux window rather than only its active pane.
keybind = cmd+shift+w=text:\x06&

# tmux owns sessions, windows, and panes within each Ghostty window.
# Command+Q closes the current Ghostty window; Shift+Command+Q quits the app.
keybind = cmd+q=close_window
keybind = cmd+shift+q=quit
keybind = cmd+shift+t=ignore
keybind = cmd+alt+w=ignore
keybind = cmd+alt+shift+w=ignore
keybind = cmd+d=ignore
keybind = cmd+shift+d=ignore
keybind = cmd+[=ignore
keybind = cmd+]=ignore
keybind = cmd+shift+[=ignore
keybind = cmd+shift+]=ignore
keybind = cmd+alt+arrow_up=ignore
keybind = cmd+alt+arrow_down=ignore
keybind = cmd+alt+arrow_left=ignore
keybind = cmd+alt+arrow_right=ignore
keybind = cmd+ctrl+arrow_up=ignore
keybind = cmd+ctrl+arrow_down=ignore
keybind = cmd+ctrl+arrow_left=ignore
keybind = cmd+ctrl+arrow_right=ignore
keybind = cmd+ctrl+==ignore
keybind = cmd+shift+enter=ignore
keybind = ctrl+tab=ignore
keybind = ctrl+shift+tab=ignore

# nvim maps Ctrl+S to save.
keybind = cmd+s=text:\x13

# ZLE and GNU Readline use Ctrl+_ for command-line undo.
keybind = cmd+z=text:\x1f
