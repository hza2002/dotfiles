{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "agent-usage",
  "type": "module",
  "title": "Agent Usage",
  "description": "Check your coding plan quotas in one view",
  "icon": "icon.png",
  "author": "hza2002",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "commands": [
