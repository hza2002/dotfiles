#!/bin/bash

set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
CHECK_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-check.XXXXXX")
MACOS_HOME="$CHECK_ROOT/stow-macos"
LINUX_HOME="$CHECK_ROOT/stow-linux"
TMUX_SOCKET="dotfiles-check-$$"

COMMON_PACKAGES=(bat btop gnupg nvim starship tmux yazi zsh)
MACOS_PACKAGES=(automation bin ghostty ideavim raycast sketchybar yabai "${COMMON_PACKAGES[@]}")

cleanup() {
  tmux -L "$TMUX_SOCKET" kill-server >/dev/null 2>&1 || true
  rm -rf "$CHECK_ROOT"
}
trap cleanup EXIT

cd "$REPO_ROOT"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 1
  }
}

run() {
  local name=$1
  shift
  printf '\n==> %s\n' "$name"
  "$@"
  printf 'ok - %s\n' "$name"
}

check_stow_profile() {
  local target=$1
  shift

  mkdir -p "$target"
  stow --no-folding --target "$target" "$@"
}

check_shell_syntax() {
  local file first

  zsh -n zsh/.zshenv zsh/.zprofile zsh/.zshrc zsh/.config/fzf/fzfrc.sh

  while IFS= read -r file; do
    IFS= read -r first < "$file" || true
    case "$first" in
      *bash*) /bin/bash -n "$file" ;;
      *'/sh') /bin/sh -n "$file" ;;
    esac
  done < <(rg --hidden -l '^#!.*(ba)?sh$' --glob '!.git/**' --glob '!**/node_modules/**')
}

check_python_syntax() {
  python3 - <<'PY'
import ast
from pathlib import Path

for path in Path(".").rglob("*.py"):
    if ".git" in path.parts or "node_modules" in path.parts:
        continue
    ast.parse(path.read_text(), filename=str(path))
PY
}

check_json() {
  local file

  while IFS= read -r file; do
    jq empty "$file"
  done < <(rg --files --hidden --glob '*.json' --glob '!.git/**' --glob '!**/node_modules/**')
}

check_agent_skills() {
  local skill name link

  [[ -L CLAUDE.md && -e CLAUDE.md && $(readlink CLAUDE.md) == AGENTS.md ]]

  for skill in .agents/skills/*; do
    [[ -f "$skill/SKILL.md" && -f "$skill/agents/openai.yaml" ]]
    name=$(sed -n 's/^name: //p' "$skill/SKILL.md" | head -n 1)
    [[ "$name" == "$(basename "$skill")" ]]
    rg -q '^description: .+' "$skill/SKILL.md"
  done

  for link in .claude/skills/*; do
    [[ -L "$link" && -e "$link/SKILL.md" ]]
  done
}

check_tmux() {
  local package_root=tmux/.config/tmux
  local test_home="$CHECK_ROOT/tmux-home"
  local wrapper="$CHECK_ROOT/tmux-check.conf"
  local file output
  local -a required=(
    tmux.conf
    conf/options.conf
    conf/bindings.conf
    conf/theme.conf
    conf/plugins.conf
    conf/ui.conf
    palettes/gruvbox.conf
    palettes/gruvbox-material-dark-medium.conf
    scripts/project-picker.sh
    scripts/ghostty-cursor-sample.sh
  )

  for file in "${required[@]}"; do
    [[ -f "$package_root/$file" ]] || {
      echo "missing tmux configuration: $package_root/$file" >&2
      return 1
    }
  done

  while IFS= read -r file; do
    [[ -x "$file" ]] || {
      echo "tmux script must be executable: $file" >&2
      return 1
    }
  done < <(find "$package_root/scripts" -type f -name '*.sh' -print)

  mkdir -p "$test_home"
  stow --no-folding --target "$test_home" tmux
  printf '%s\n' \
    'set -g @skip_plugin_reload 1' \
    'source-file ~/.config/tmux/tmux.conf' >"$wrapper"

  if ! output=$(HOME="$test_home" tmux -L "$TMUX_SOCKET" \
    -f "$wrapper" new-session -d 2>&1); then
    printf '%s\n' "$output" >&2
    return 1
  fi
  if [[ -n "$output" ]]; then
    printf 'tmux configuration produced unexpected output:\n%s\n' "$output" >&2
    return 1
  fi

  HOME="$test_home" tmux -L "$TMUX_SOCKET" kill-server
}

check_ghostty_config() {
  HOME="$MACOS_HOME" ghostty +validate-config \
    --config-file="$MACOS_HOME/.config/ghostty/config"
}

check_plists() {
  local file

  while IFS= read -r file; do
    plutil -lint "$file"
  done < <(find automation -type f \( -name '*.plist' -o -name '*.plist.template' \) -print)
}

check_raycast_extension() {
  local extension=$1
  (
    cd "raycast/extensions/$extension"
    npm test
    npm run lint
  )
}

require git
require stow
require rg
require zsh
require python3
require jq
require tmux

run "macOS Stow profile" check_stow_profile "$MACOS_HOME" "${MACOS_PACKAGES[@]}"
run "Linux Stow profile" check_stow_profile "$LINUX_HOME" "${COMMON_PACKAGES[@]}"
run "shell syntax" check_shell_syntax
run "Python syntax" check_python_syntax
run "JSON syntax" check_json
run "agent skill layout" check_agent_skills
run "tmux clean-home startup" check_tmux

if [[ $(uname -s) == Darwin ]]; then
  extension_dir=
  require plutil
  require ghostty
  require npm

  run "Automation LaunchAgent installer" /bin/bash tests/automation_install_test.sh
  run "Automation plist files" check_plists
  run "Ghostty config" check_ghostty_config

  for test_file in sketchybar/.config/sketchybar/tests/*_test.sh; do
    run "SketchyBar $(basename "$test_file")" /bin/bash "$test_file"
  done

  for extension_dir in raycast/extensions/*; do
    [[ -f "$extension_dir/package.json" ]] || continue
    run "Raycast $(basename "$extension_dir")" \
      check_raycast_extension "$(basename "$extension_dir")"
  done
else
  printf '\nSKIP - macOS-only runtime checks\n'
fi

run "whitespace errors" git diff --check
run "staged whitespace errors" git diff --cached --check

printf '\nAll checks passed.\n'
