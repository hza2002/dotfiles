#!/bin/bash

set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

usage() {
  printf '%s\n' \
    'Usage: ./check [component [test]]' \
    '' \
    'No arguments: run all checks.' \
    '  repo                     Cross-package Stow, syntax, and agent layout' \
    '  sketchybar [test]        All SketchyBar tests, or one test file stem' \
    '                           volume runs volume_device + plugin_boundaries' \
    '  tmux [startup|copy-mode] All tmux checks, or one runtime check' \
    '  zsh                      Zsh syntax and startup contract' \
    '  ghostty                  Ghostty configuration' \
    '  automation [chrome-icon] Automation installer and plist checks' \
    '  raycast [extension]      All extensions, or one extension' \
    '' \
    'Component checks include scoped syntax, Stow, and whitespace checks.' \
    'Use ./check sketchybar front_app, for example, for front_app_test.sh.'
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
if [[ $# -gt 2 ]]; then
  usage >&2
  exit 64
fi
COMPONENT=${1:-all}
SELECTOR=${2:-}
SCOPE=.

case "$COMPONENT:$SELECTOR" in
  all:|repo:) ;;
  sketchybar:*)
    SCOPE=sketchybar
    if [[ -n "$SELECTOR" && "$SELECTOR" != volume ]]; then
      if [[ ! "$SELECTOR" =~ ^[a-z][a-z0-9_]*$ ]] \
        || [[ ! -f "$REPO_ROOT/sketchybar/.config/sketchybar/tests/${SELECTOR}_test.sh" ]]; then
        printf 'Unknown SketchyBar test: %s\n' "$SELECTOR" >&2
        exit 64
      fi
    fi
    ;;
  tmux:|tmux:startup|tmux:copy-mode) SCOPE=tmux ;;
  zsh:|ghostty:) SCOPE=$COMPONENT ;;
  automation:|automation:chrome-icon) SCOPE=automation ;;
  raycast:*)
    SCOPE=raycast
    if [[ -n "$SELECTOR" ]]; then
      if [[ ! "$SELECTOR" =~ ^[a-z][a-z0-9-]*$ ]] \
        || [[ ! -f "$REPO_ROOT/raycast/extensions/$SELECTOR/package.json" ]]; then
        printf 'Unknown Raycast extension: %s\n' "$SELECTOR" >&2
        exit 64
      fi
      SCOPE="raycast/extensions/$SELECTOR"
    fi
    ;;
  *) printf 'Unknown check selection: %s %s\n' "$COMPONENT" "$SELECTOR" >&2; usage >&2; exit 64 ;;
esac

CHECK_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-check.XXXXXX")
MACOS_HOME="$CHECK_ROOT/stow-macos"
LINUX_HOME="$CHECK_ROOT/stow-linux"
# `$$` survives the subshells `run` uses, so cleanup can always find the server.
TMUX_SOCKET="dotfiles-check-$$"
FAILED=()

COMMON_PACKAGES=(bat btop gnupg nvim starship tmux yazi zsh)
MACOS_PACKAGES=(bin ghostty ideavim raycast sketchybar yabai "${COMMON_PACKAGES[@]}")
AUTOMATION_PACKAGES=(chrome-icon)

cleanup() {
  tmux -L "$TMUX_SOCKET" kill-server >/dev/null 2>&1 || true
  rm -rf "$CHECK_ROOT"
}
trap cleanup EXIT

cd "$REPO_ROOT"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 1
  }
}

run() {
  local name=$1 status=0
  shift
  printf '\n==> %s\n' "$name"
  # The check keeps its own fail-fast behavior inside a subshell: a failure is
  # recorded here instead of ending the run, so later checks still report.
  set +e
  ( set -e; "$@" )
  status=$?
  set -e
  if (( status != 0 )); then
    printf 'FAIL - %s\n' "$name"
    FAILED+=("$name")
    return 0
  fi
  printf 'ok - %s\n' "$name"
}

check_stow_profile() {
  local target=$1
  shift

  require stow
  mkdir -p "$target"
  stow --no-folding --target "$target" "$@"
}

check_stow_collection() {
  local target=$1
  local directory=$2
  shift 2

  require stow
  mkdir -p "$target"
  stow --no-folding --dir "$directory" --target "$target" "$@"
}

check_shell_syntax() {
  local scope=${1:-.} file first

  require rg
  if [[ "$scope" = . || "$scope" = zsh ]]; then
    require zsh
    for file in zsh/.zshenv zsh/.zprofile zsh/.zshrc zsh/.config/fzf/fzfrc.sh; do
      zsh -n "$file"
    done
  fi

  while IFS= read -r file; do
    IFS= read -r first < "$file" || true
    case "$first" in
      *bash*) /bin/bash -n "$file" ;;
      *'/sh') /bin/sh -n "$file" ;;
    esac
  done < <(rg --hidden -l '^#!.*(ba)?sh$' --glob '!.git/**' --glob '!**/node_modules/**' -- "$scope")
}

check_zsh_startup() {
  require zsh
  local test_home="$CHECK_ROOT/zsh-home"
  local state_home="$test_home/.local/state"
  local -a shell_env=(
    env -i
    HOME="$test_home"
    USER="${USER:-dotfiles-check}"
    LOGNAME="${LOGNAME:-dotfiles-check}"
    SHELL=/bin/zsh
    TERM=dumb
    ZDOTDIR="$REPO_ROOT/zsh"
    XDG_STATE_HOME="$state_home"
    # /etc/zsh/zshrc compinit would dump into $ZDOTDIR, i.e. the repo: compinit
    # takes its dump path from -d, not the environment. oh-my-zsh owns that here.
    skip_global_compinit=1
  )
  local mode arch output

  mkdir -p "$test_home/.local/bin" "$test_home/.oh-my-zsh" "$test_home/.jenv/shims"
  cat >"$test_home/.local/bin/fnm" <<'EOF'
#!/bin/sh
if [ "${1:-}" = env ]; then
  [ "${FNM_ARCH:-}" = invalid ] && exit 1
  printf '%s\n' \
    "export FNM_MULTISHELL_PATH='$XDG_STATE_HOME/fnm_multishells/current'" \
    'export PATH="$FNM_MULTISHELL_PATH/bin:$PATH"' \
    '_fnm_autoload_hook() { export FNM_HOOK_RAN=1; }'
fi
EOF
  chmod +x "$test_home/.local/bin/fnm"
  cat >"$test_home/.oh-my-zsh/oh-my-zsh.sh" <<'EOF'
function abbr() { :; }
function bindkey() { :; }
function lazyload() { :; }
EOF

  for mode in -lc -ic; do
    for arch in valid invalid; do
      output=$("${shell_env[@]}" EDITOR=caller-editor ZSH_OS=Unexpected \
        GPG_TTY=stale FNM_ARCH="$arch" \
        FNM_MULTISHELL_PATH="$state_home/fnm_multishells/old" \
        PATH="$test_home/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$state_home/fnm_multishells/old/bin" \
        /bin/zsh "$mode" '
          set -e
          [[ "$EDITOR" == caller-editor && "$ZSH_OS" != Unexpected ]]
          fnm_paths=("${(@M)path:#$XDG_STATE_HOME/fnm_multishells/*/bin}")
          (( ${#fnm_paths} == 1 ))
          [[ "$fnm_paths[1]" == "$FNM_MULTISHELL_PATH/bin" ]]
          if [[ "$FNM_ARCH" == valid ]]; then
            [[ "$FNM_HOOK_RAN" == 1 ]]
          else
            [[ "$FNM_MULTISHELL_PATH" == "$XDG_STATE_HOME/fnm_multishells/old" ]]
          fi
          if [[ -o interactive ]]; then
            (( ! ${+GPG_TTY} ))
          else
            (( ! ${+aliases[rm]} && ! ${+functions[y]} ))
            (( ${path[(Ie)$HOME/.jenv/shims]} > 0 ))
          fi
          print -r -- ok
        ' </dev/null)
      [[ "$output" == ok ]]
    done
  done
}

check_python_syntax() {
  local scope=${1:-.} files
  files=$(rg --files --hidden --glob '*.py' --glob '!.git/**' --glob '!**/node_modules/**' -- "$scope") \
    || { [[ $? -eq 1 ]] && return 0; return 1; }
  require python3
  python3 - "$scope" <<'PY'
import ast
import sys
from pathlib import Path

for path in Path(sys.argv[1]).rglob("*.py"):
    if ".git" in path.parts or "node_modules" in path.parts:
        continue
    ast.parse(path.read_text(), filename=str(path))
PY
}

check_json() {
  local scope=${1:-.} file

  while IFS= read -r file; do
    require jq
    jq empty "$file"
  done < <(rg --files --hidden --glob '*.json' --glob '!.git/**' --glob '!**/node_modules/**' -- "$scope")
}

check_agent_skills() {
  local skill name link

  [[ -L CLAUDE.md && -e CLAUDE.md && $(readlink CLAUDE.md) == AGENTS.md ]]

  for skill in .agents/skills/*; do
    [[ -f "$skill/SKILL.md" && -f "$skill/agents/openai.yaml" ]]
    name=$(sed -n 's/^name: //p' "$skill/SKILL.md" | head -n 1)
    [[ "$name" == "$(basename "$skill")" ]]
    rg -q '^description: .+' "$skill/SKILL.md"
  done

  for link in .claude/skills/*; do
    [[ -L "$link" && -e "$link/SKILL.md" ]]
  done
}

check_tmux() {
  require tmux
  require stow
  local package_root=tmux/.config/tmux
  local test_home="$CHECK_ROOT/tmux-home"
  local wrapper="$CHECK_ROOT/tmux-check.conf"
  local file output
  local -a required=(
    tmux.conf
    conf/options.conf
    conf/bindings.conf
    conf/theme.conf
    conf/plugins.conf
    conf/ui.conf
    palettes/gruvbox.conf
    palettes/gruvbox-material-dark-medium.conf
    scripts/project-picker.sh
    scripts/ghostty-cursor-sample.sh
  )

  for file in "${required[@]}"; do
    [[ -f "$package_root/$file" ]] || {
      echo "missing tmux configuration: $package_root/$file" >&2
      return 1
    }
  done

  while IFS= read -r file; do
    [[ -x "$file" ]] || {
      echo "tmux script must be executable: $file" >&2
      return 1
    }
  done < <(find "$package_root/scripts" -type f -name '*.sh' -print)

  mkdir -p "$test_home"
  stow --no-folding --target "$test_home" tmux
  printf '%s\n' \
    'set -g @skip_plugin_reload 1' \
    'source-file ~/.config/tmux/tmux.conf' >"$wrapper"

  if ! output=$(HOME="$test_home" tmux -L "$TMUX_SOCKET" \
    -f "$wrapper" new-session -d 2>&1); then
    printf '%s\n' "$output" >&2
    return 1
  fi
  if [[ -n "$output" ]]; then
    printf 'tmux configuration produced unexpected output:\n%s\n' "$output" >&2
    return 1
  fi

  HOME="$test_home" tmux -L "$TMUX_SOCKET" kill-server
}

check_ghostty_config() {
  require ghostty
  HOME="$MACOS_HOME" ghostty +validate-config \
    --config-file="$MACOS_HOME/.config/ghostty/config"
}

check_plists() {
  local file
  require plutil

  while IFS= read -r file; do
    plutil -lint "$file"
  done < <(find automation -type f \( -name '*.plist' -o -name '*.plist.template' \) -print)
}

check_raycast_extension() {
  local extension=$1
  require npm
  (
    cd "raycast/extensions/$extension"
    # `ray build` writes its dev output over the copy Raycast runs, so the
    # check builds somewhere disposable instead: checking a component must not
    # deploy it.
    npm run build -- -o "$CHECK_ROOT/raycast-$extension"
    npm test
    npm run lint
  )
}

check_syntax() {
  local scope=$1
  run "shell syntax ($scope)" check_shell_syntax "$scope"
  run "Python syntax ($scope)" check_python_syntax "$scope"
  run "JSON syntax ($scope)" check_json "$scope"
}

check_repository() {
  run "macOS Stow profile" check_stow_profile "$MACOS_HOME" "${MACOS_PACKAGES[@]}"
  run "Automation Stow profile" \
    check_stow_collection "$MACOS_HOME" automation "${AUTOMATION_PACKAGES[@]}"
  run "Linux Stow profile" check_stow_profile "$LINUX_HOME" "${COMMON_PACKAGES[@]}"
  check_syntax .
  run "agent skill layout" check_agent_skills
}

check_sketchybar() {
  local selector=$1 test_file
  local tests=()
  case "$selector" in
    '') tests=(sketchybar/.config/sketchybar/tests/*_test.sh) ;;
    volume)
      tests=(sketchybar/.config/sketchybar/tests/volume_device_test.sh
             sketchybar/.config/sketchybar/tests/plugin_boundaries_test.sh)
      ;;
    *) tests=("sketchybar/.config/sketchybar/tests/${selector}_test.sh") ;;
  esac
  for test_file in "${tests[@]}"; do
    run "SketchyBar $(basename "$test_file")" /bin/bash "$test_file"
  done
}

check_component() {
  local component=$1 selector=${2:-} extension_dir
  case "$component" in
    zsh) run "Zsh startup contract" check_zsh_startup; return ;;
    tmux)
      require tmux
      if [[ "$selector" != copy-mode ]]; then
        run "tmux clean-home startup" check_tmux
      fi
      if [[ "$selector" != startup ]]; then
        run "tmux copy-mode and idle-pane behavior" /bin/bash tmux/tests/copy-mode-test.sh
      fi
      return
      ;;
  esac

  if [[ $(uname -s) != Darwin ]]; then
    printf '\nSKIP - %s runtime checks require macOS\n' "$component"
    return
  fi
  case "$component" in
    sketchybar) check_sketchybar "$selector" ;;
    ghostty) run "Ghostty config" check_ghostty_config ;;
    automation)
      run "Chrome Icon LaunchAgent installer" /bin/bash automation/chrome-icon/tests/install_test.sh
      run "Automation plist files" check_plists
      ;;
    raycast)
      if [[ -z "$selector" ]]; then
        for extension_dir in raycast/extensions/*; do
          [[ -f "$extension_dir/package.json" ]] || continue
          run "Raycast $(basename "$extension_dir")" check_raycast_extension "$(basename "$extension_dir")"
        done
      else
        run "Raycast $selector" check_raycast_extension "$selector"
      fi
      ;;
  esac
}

require git
require rg
case "$COMPONENT" in
  all|repo)
    check_repository
    if [[ "$COMPONENT" = all ]]; then
      for component in zsh tmux automation ghostty sketchybar raycast; do
        check_component "$component"
      done
    fi
    ;;
  *)
    if [[ "$COMPONENT" = automation ]]; then
      run "Automation Stow profile" check_stow_collection "$MACOS_HOME" automation "${AUTOMATION_PACKAGES[@]}"
    else
      run "$COMPONENT Stow package" check_stow_profile "$MACOS_HOME" "$COMPONENT"
    fi
    check_syntax "$SCOPE"
    check_component "$COMPONENT" "$SELECTOR"
    ;;
esac

run "whitespace errors ($SCOPE)" git diff --check -- "$SCOPE"
run "staged whitespace errors ($SCOPE)" git diff --cached --check -- "$SCOPE"

if (( ${#FAILED[@]} > 0 )); then
  printf '\nFailed checks:\n' >&2
  printf ' - %s\n' "${FAILED[@]}" >&2
  exit 1
fi

printf '\nAll selected checks passed (%s%s).\n' "$COMPONENT" "${SELECTOR:+ $SELECTOR}"
