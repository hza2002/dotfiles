#!/usr/bin/env bash
# Pick the pinentry flavor to use.
#
# gpg-agent is a long-lived daemon: it launches this program with its own
# (minimal) environment, so it can't see the client's tty/SSH/tmux state and
# its PATH may not include Homebrew. Two consequences drive this script:
#
#   1. The GUI-vs-terminal decision is made client-side (in the shell rc) and
#      forwarded here via PINENTRY_USER_DATA, which gpg passes through the agent
#      to the pinentry program. The rc sets it to "curses" for SSH/tmux sessions.
#   2. We put the Homebrew bin dirs on PATH ourselves so the binaries resolve
#      regardless of the agent's environment, instead of hardcoding a prefix.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

case "$PINENTRY_USER_DATA" in
  *curses*) exec pinentry-curses "$@" ;;
esac

# Default: native macOS GUI if available, otherwise fall back to curses
# (e.g. Intel Homebrew, Linux, or a headless box without pinentry-mac).
if command -v pinentry-mac >/dev/null 2>&1; then
  exec pinentry-mac "$@"
fi
exec pinentry-curses "$@"
