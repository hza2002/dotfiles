" IdeaVim host adapter for the current standalone LazyVim configuration.
" Pure Vim mappings use *noremap; JetBrains <Action> mappings must use *map.

" Leader keys must be defined before plugins and mappings.
let mapleader = " "
let maplocalleader = "\\"
set timeout
set timeoutlen=1000

" IdeaVim plugins that reproduce behavior used by the current Neovim setup.
set commentary
set highlightedyank
set matchit
set vim-paragraph-motion

" IdeaVimExtension: switch to English when leaving Insert mode.
set keep-english-in-normal

" Shared editor behavior.
set clipboard=unnamed,unnamedplus,ideaput
set hlsearch
set history=1000
set incsearch
set showcmd
set showmode
set smartcase
set visualbell
set scrolloff=5
set number
set relativenumber
set ideajoin

" Display-line movement, matching LazyVim when no count is given.
nnoremap <expr> j v:count == 0 ? 'gj' : 'j'
xnoremap <expr> j v:count == 0 ? 'gj' : 'j'
nnoremap <expr> k v:count == 0 ? 'gk' : 'k'
xnoremap <expr> k v:count == 0 ? 'gk' : 'k'

" Personal mappings shared with the standalone Neovim config.
inoremap <S-Delete> <Delete>
xnoremap p "_dP
nnoremap K i<CR><Esc>
inoremap <C-e> <Esc>A
inoremap <C-a> <Esc>I

" Save and return to Normal mode, matching LazyVim's Ctrl-S behavior.
nnoremap <C-s> :write<CR>
inoremap <C-s> <C-o>:write<CR><Esc>
xnoremap <C-s> <Esc>:write<CR>

" Move lines/statements using JetBrains-aware actions.
nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
imap <A-j> <Action>(MoveLineDown)
imap <A-k> <Action>(MoveLineUp)
xmap <A-j> <Action>(MoveStatementDown)
xmap <A-k> <Action>(MoveStatementUp)

" Previous/next editor tab is the JetBrains equivalent of a buffer.
nmap <S-h> <Action>(PreviousTab)
nmap <S-l> <Action>(NextTab)
nmap [b <Action>(PreviousTab)
nmap ]b <Action>(NextTab)

" Window navigation also works from Insert mode and returns to Insert mode.
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
inoremap <C-h> <C-o><C-w>h
inoremap <C-j> <C-o><C-w>j
inoremap <C-k> <C-o><C-w>k
inoremap <C-l> <C-o><C-w>l

" Keep these shortcuts in Vim except while an IDE completion popup owns them.
sethandler <C-H> n-i:vim
sethandler <C-J> n-i:vim
sethandler <C-K> n-i:vim
sethandler <C-L> n-i:vim

" Incremental split resizing; macOS must not intercept these shortcuts.
nmap <C-Up> <Action>(IncrementWindowHeight)
nmap <C-Down> <Action>(DecrementWindowHeight)
nmap <C-Left> <Action>(DecrementWindowWidth)
nmap <C-Right> <Action>(IncrementWindowWidth)

" Keep the selection after indentation.
xnoremap < <gv
xnoremap > >gv

" Search direction follows the original / or ? command and opens folds.
nnoremap <expr> n 'Nn'[v:searchforward] . 'zv'
xnoremap <expr> n 'Nn'[v:searchforward]
onoremap <expr> n 'Nn'[v:searchforward]
nnoremap <expr> N 'nN'[v:searchforward] . 'zv'
xnoremap <expr> N 'nN'[v:searchforward]
onoremap <expr> N 'nN'[v:searchforward]

" Code navigation. JetBrains merges declaration and definition in many languages.
nmap gd <Action>(GotoDeclaration)
nmap gr <Action>(ShowUsages)
nmap gI <Action>(GotoImplementation)
nmap gy <Action>(GotoTypeDeclaration)
nmap gD <Action>(GotoDeclaration)
nmap gh <Action>(ShowHoverInfo)
nmap gK <Action>(ParameterInfo)

" Diagnostics and Git hunks.
nmap [d <Action>(GotoPreviousError)
nmap ]d <Action>(GotoNextError)
nmap [e <Action>(GotoPreviousError)
nmap ]e <Action>(GotoNextError)
nmap [h <Action>(VcsShowPrevChangeMarker)
nmap ]h <Action>(VcsShowNextChangeMarker)

" Buffers / editor tabs.
nmap <leader>bb <Action>(Switcher)
nmap <leader>bd <Action>(CloseEditor)
nmap <leader>bo <Action>(CloseAllEditorsButActive)
nmap <leader>, <Action>(RecentFiles)

" Code actions.
nmap <leader>ca <Action>(ShowIntentionActions)
xmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>cd <Action>(ShowErrorDescription)
nmap <leader>cf <Action>(ReformatCode)
xmap <leader>cf <Action>(ReformatCode)
nmap <leader>co <Action>(OptimizeImports)
nmap <leader>cr <Action>(RenameElement)

" Files and project navigation. Project scope is the closest JetBrains root scope.
nmap <leader><space> <Action>(GotoFile)
nmap <leader>ff <Action>(GotoFile)
nmap <leader>fp <Action>(OpenProjectWindows)
nmap <leader>fr <Action>(RecentFiles)
nmap <leader>e <Action>(SelectInProjectView)
nmap <leader>E <Action>(ActivateProjectToolWindow)

" Search.
nmap <leader>/ <Action>(FindInPath)
nmap <leader>sC <Action>(GotoAction)
nmap <leader>sg <Action>(FindInPath)
nmap <leader>sr <Action>(ReplaceInPath)
xmap <leader>sr <Action>(ReplaceInPath)
nmap <leader>ss <Action>(FileStructurePopup)

" Git. These use JetBrains VCS views as semantic equivalents.
nmap <leader>gb <Action>(Annotate)
nmap <leader>gf <Action>(Vcs.ShowTabbedFileHistory)
nmap <leader>gg <Action>(ActivateVersionControlToolWindow)
nmap <leader>ghr <Action>(Vcs.RollbackChangedLines)
xmap <leader>ghr <Action>(Vcs.RollbackChangedLines)

" Windows. <leader>wf is the user's Neovim alias for full-window zoom.
nnoremap <leader>- <C-w>s
nnoremap <leader><Bar> <C-w>v
nnoremap <leader>wd <C-w>c
nmap <leader>wm <Action>(MaximizeEditorInSplit)
nmap <leader>wf <Action>(MaximizeEditorInSplit)

" UI.
nmap <leader>uz <Action>(ToggleDistractionFreeMode)

" Reload this file after editing.
nmap <leader>ur <Action>(IdeaVim.ReloadVimRc.reload)
